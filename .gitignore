# Defense in depth. Nothing confidential should be inside this directory at all,
# but if it ever lands here by accident, these patterns keep it out of a commit.

# Local environment
.env
.env.*
.DS_Store
node_modules/
# Fetched source corpus. Episode transcripts and wiki articles are the show's
# copyright regardless of who typed them up, so the fetch script is committed and
# its output never is. See docs/design.md, "Three tiers of content".
.corpus/

# Build output
dist/
coverage/
